{
  "info": {
    "_postman_id": "3f7a1c22-5b64-4d1e-9a3f-0c2e8b7d4a11",
    "name": "Bulk Action Platform",
    "description": "Bulk action platform over a Postgres backed job queue. Set baseUrl and bulkActionId in the collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "bulkActionId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Confirms the API process is up without touching the database."
      },
      "response": []
    },
    {
      "name": "List contacts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/contacts?limit=5&offset=0",
          "host": ["{{baseUrl}}"],
          "path": ["contacts"],
          "query": [
            { "key": "limit", "value": "5" },
            { "key": "offset", "value": "0" }
          ]
        },
        "description": "Lists seeded contacts so the rows changed by a bulk action can be checked before and after."
      },
      "response": []
    },
    {
      "name": "Create bulk action - multi field update",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": \"acc_1\",\n  \"entityType\": \"contact\",\n  \"actionType\": \"bulk_update\",\n  \"configuration\": {\n    \"fields\": {\n      \"age\": 30,\n      \"status\": \"inactive\"\n    }\n  },\n  \"scheduledAt\": null\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/bulk-actions",
          "host": ["{{baseUrl}}"],
          "path": ["bulk-actions"]
        },
        "description": "Queues an update of two fields at once across every contact on the account."
      },
      "response": []
    },
    {
      "name": "List bulk actions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/bulk-actions?limit=20&offset=0",
          "host": ["{{baseUrl}}"],
          "path": ["bulk-actions"],
          "query": [
            { "key": "limit", "value": "20" },
            { "key": "offset", "value": "0" }
          ]
        },
        "description": "Lists bulk actions newest first, with total, limit and offset for paging."
      },
      "response": []
    },
    {
      "name": "Get bulk action by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/bulk-actions/{{bulkActionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["bulk-actions", "{{bulkActionId}}"]
        },
        "description": "Returns one bulk action with progress as processed, total and percentage."
      },
      "response": []
    },
    {
      "name": "Get bulk action stats",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/bulk-actions/{{bulkActionId}}/stats",
          "host": ["{{baseUrl}}"],
          "path": ["bulk-actions", "{{bulkActionId}}", "stats"]
        },
        "description": "Counts success, failed, skipped and pending entities for one bulk action."
      },
      "response": []
    },
    {
      "name": "Get bulk action logs",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/bulk-actions/{{bulkActionId}}/logs?limit=50&offset=0",
          "host": ["{{baseUrl}}"],
          "path": ["bulk-actions", "{{bulkActionId}}", "logs"],
          "query": [
            { "key": "limit", "value": "50" },
            { "key": "offset", "value": "0" }
          ]
        },
        "description": "Returns the per entity log rows written by the worker, newest page first by id."
      },
      "response": []
    }
  ]
}
